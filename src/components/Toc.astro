---
/** 维基式目录框。章节来自条目自身的 h2/h3，不是手工维护的清单。 */
interface Heading {
  depth: number
  slug: string
  text: string
}
interface Props {
  headings: Heading[]
  /** 追加一项非正文章节，例如「参见」 */
  extra?: string
}
const { headings, extra } = Astro.props

// 维基的目录编号是层级式的（1、1.1、2…），这里按 h2/h3 生成同样的编号
let h2 = 0
let h3 = 0
const items = headings.map((h) => {
  if (h.depth === 2) {
    h2 += 1
    h3 = 0
    return { ...h, num: String(h2) }
  }
  h3 += 1
  return { ...h, num: `${h2}.${h3}` }
})
---

<nav class="wiki-toc" aria-label="目录">
  <div class="wiki-toc-title">目录</div>
  <ol class="toc-list">
    {
      items.map((h) => (
        <li class={h.depth === 3 ? 'd3' : undefined}>
          <a href={`#${h.slug}`}>
            <span class="wiki-tocnum">{h.num}</span>{h.text}
          </a>
        </li>
      ))
    }
    {
      extra && (
        <li>
          <a href="#see-also">
            <span class="wiki-tocnum">{h2 + 1}</span>{extra}
          </a>
        </li>
      )
    }
  </ol>
</nav>

<script>
  // 滚动高亮当前章节。用 IntersectionObserver 而非 scroll 事件：
  // 不需要节流，也不会在快速滚动时抖动。
  const links = new Map<string, HTMLElement>()
  document.querySelectorAll<HTMLAnchorElement>('.wiki-toc a[href^="#"]').forEach((a) => {
    links.set(decodeURIComponent(a.getAttribute('href')!.slice(1)), a)
  })
  const targets = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => !!el)

  if (targets.length > 0 && !window.matchMedia('(max-width: 900px)').matches) {
    let active: HTMLElement | null = null
    const setActive = (id: string) => {
      const a = links.get(id)
      if (!a || a === active) return
      active?.classList.remove('current')
      active?.parentElement?.classList.remove('current')
      a.classList.add('current')
      a.parentElement?.classList.add('current')
      active = a
    }
    // 记录每个标题当前是否在「视口上沿以下」，取最靠上的那个可见标题
    const seen = new Map<string, boolean>()
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) seen.set(e.target.id, e.isIntersecting)
        // 优先取正在视口内的第一个；都不在时取最后一个已滚过的
        const visible = targets.find((t) => seen.get(t.id))
        if (visible) return setActive(visible.id)
        const passed = [...targets].reverse().find((t) => t.getBoundingClientRect().top < 0)
        if (passed) setActive(passed.id)
      },
      // 上沿留出一点余量，标题刚滚到顶时就切换
      { rootMargin: '-8% 0px -75% 0px', threshold: 0 },
    )
    targets.forEach((t) => io.observe(t))
  }
</script>
