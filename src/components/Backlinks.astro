---
import type { Ref } from '../lib/linkgraph'

interface Props {
  refs: Ref[]
}

const { refs } = Astro.props
---

{
  refs.length > 0 && (
    <section class="mt-14">
      {/* 与首页索引同一套栏位结构：左栏标签、右侧概念流。
          反链是这个站的第二套导航，不该长得像文章末尾的附注。 */}
      <div class="sheet-row">
        <span class="u sheet-label">被提到</span>
        <div class="sheet-flow">
          {refs.map((ref) => (
            <a href={ref.href} class="concept">
              {ref.title}
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
