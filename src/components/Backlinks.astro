---
import type { Ref } from '../lib/linkgraph'

interface Props {
  refs: Ref[]
}
const { refs } = Astro.props
---

{
  refs.length > 0 && (
    <section>
      {/* 维基的「参见」是人工列的；这里是构建时扫全站算出来的 ——
          谁提到了本条目，它就在这儿，不会漏。 */}
      <h2 id="see-also" class="wiki-h2">参见</h2>
      <p class="wiki-note see-note">以下页面提到了本条目，自动生成。</p>
      <ul class="see">
        {refs.map((ref) => (
          <li>
            <a href={ref.href}>{ref.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .see-note {
    margin: 0 0 0.4em;
  }
  .see {
    margin: 0;
    padding-left: 1.6rem;
    columns: 2;
    column-gap: 2rem;
  }
  .see li {
    line-height: 1.8;
    break-inside: avoid;
  }
  .see a {
    color: var(--color-link);
    text-decoration: none;
  }
  .see a:hover {
    text-decoration: underline;
  }
  @media (max-width: 640px) {
    .see {
      columns: 1;
    }
  }
</style>
