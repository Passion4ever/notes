---
interface Props {
  /** PDB ID，与 src 二选一 */
  pdb?: string
  /** 本地或远程结构文件 URL，与 pdb 二选一 */
  src?: string
  /** src 的格式，默认 mmcif */
  format?: string
  caption?: string
  height?: number
}

const { pdb, src, format = 'mmcif', caption, height = 420 } = Astro.props

if (!pdb && !src) {
  throw new Error('<Structure> 必须提供 pdb 或 src 之一')
}

const label = caption ?? pdb ?? src!
---

<figure class="wiki-figure">
  <div
    class="structure-host"
    style={`height:${height}px`}
    data-pdb={pdb}
    data-src={src}
    data-format={format}
  >
    <button class="structure-load wiki-btn" type="button">
      加载 3D 结构 · {pdb ?? '本地文件'}
    </button>
    <p class="structure-status hidden"></p>
  </div>
  <figcaption>{label}</figcaption>
</figure>

<script>
  const MOLSTAR_CONFIG = {
    layoutIsExpanded: false,
    layoutShowControls: false,
    layoutShowRemoteState: false,
    layoutShowSequence: false,
    layoutShowLog: false,
    layoutShowLeftPanel: false,
    collapseLeftPanel: true,
    collapseRightPanel: true,
    viewportShowExpand: false,
    viewportShowToggleFullscreen: false,
    viewportShowControls: false,
    viewportShowSettings: false,
    viewportShowSelectionMode: false,
    viewportShowAnimation: false,
    volumeStreamingDisabled: true,
  }

  let assetsPromise: Promise<void> | null = null

  /**
   * molstar.js 约 4.8 MB，只在首次点击时加载一次。
   *
   * 设计取舍——molstar.css 加载失败按「降级」处理，不阻断整体加载：
   * CSS 只影响 3D 视图的外观（工具栏/面板布局等），不影响核心的 3D 渲染能力本身；
   * 能看到结构远比样式好不好看重要。因此只有 molstar.js（真正的功能主体）加载失败
   * 才会 reject；molstar.css 失败只在控制台留一条警告。
   *
   * `settled` 是双保险：只有 script 尚未 resolve 时才允许 script.onerror 触发清理
   * （移除已插入的 <link>/<script>、把 assetsPromise 重置为 null）。正常浏览器语义下
   * 同一个 <script> 元素的 load/error 只会触发其一，理论上碰不到"molstar.js 已经成功
   * 加载、之后又被判定失败"这种情况；但如果没有这道防线，一旦真的发生了类似的重复触发
   * 或未来代码改动引入新的失败路径，就会把已经生效的 assetsPromise 和 script 标签
   * 误删——导致下次点击（本实例重试，或页面上另一个 <Structure> 实例）重新注入
   * <script src=molstar.js>，重复拉取并重新执行整个 4.8MB bundle。
   */
  function loadMolstarAssets(): Promise<void> {
    if (assetsPromise) return assetsPromise

    assetsPromise = new Promise<void>((resolve, reject) => {
      let settled = false

      const css = document.createElement('link')
      css.rel = 'stylesheet'
      css.href = '/molstar/molstar.css'

      const script = document.createElement('script')
      script.src = '/molstar/molstar.js'

      css.onerror = () => {
        console.warn('[Structure] molstar.css 加载失败，3D 视图外观可能不完整，但仍会尝试渲染结构')
      }

      script.onload = () => {
        if (settled) return
        settled = true
        resolve()
      }
      script.onerror = () => {
        if (settled) return
        settled = true
        css.remove()
        script.remove()
        assetsPromise = null
        reject(new Error('molstar.js 加载失败'))
      }

      document.head.appendChild(css)
      document.head.appendChild(script)
    })

    return assetsPromise
  }

  let viewerSeq = 0

  document.querySelectorAll<HTMLElement>('.structure-host').forEach((host) => {
    const button = host.querySelector<HTMLButtonElement>('.structure-load')
    const status = host.querySelector<HTMLElement>('.structure-status')
    if (!button || !status) return

    const setStatus = (message: string) => {
      status.textContent = message
      status.classList.remove('hidden')
    }

    button.addEventListener('click', async () => {
      button.disabled = true
      button.textContent = '加载中…'
      status.classList.add('hidden')

      let mount: HTMLDivElement | null = null
      let viewer: any = null

      try {
        await loadMolstarAssets()

        mount = document.createElement('div')
        mount.id = `molstar-viewer-${viewerSeq++}`
        mount.style.position = 'absolute'
        mount.style.inset = '0'
        host.appendChild(mount)
        // 加载成功前只隐藏按钮、不从 DOM 移除：后面任何一步失败都还能把它恢复成「重试」。
        button.style.display = 'none'

        viewer = await (window as any).molstar.Viewer.create(mount.id, MOLSTAR_CONFIG)

        if (host.dataset.pdb) {
          await viewer.loadPdb(host.dataset.pdb)
        } else {
          await viewer.loadStructureFromUrl(host.dataset.src, host.dataset.format, false)
        }

        // molstar 的 loadPdb/loadStructureFromUrl 在结构文件下载或解析失败时不会
        // reject——失败会被它自己的日志系统吞掉，返回的 promise 依然 resolve（已用真实
        // 浏览器实测确认：拦截结构文件请求后 loadPdb 仍然 resolve）。因此不能只靠
        // try/catch 判断是否成功，还要检查 hierarchy 里是否真的多了一个结构。
        //
        // 这条路径（plugin.managers.structure.hierarchy...）是 molstar 的非公开内部
        // 结构，不保证跨版本稳定，因此全程用可选链保护。断链只能说明"这条路径在当前
        // 版本里可能已经变了"，不能证明结构真的下载失败——用不同的错误文案把这两种
        // 情况区分开，避免以后排查时把"molstar 内部 API 变了"误当成"结构真的加载失败"。
        const structureCount = (viewer as any)?.plugin?.managers?.structure?.hierarchy?.current
          ?.structures?.length
        if (structureCount === undefined) {
          const version = (window as any).molstar?.version ?? '未知'
          throw new Error(`无法确认结构加载结果：molstar 内部结构可能已变更（当前 molstar 版本：${version}）`)
        }
        if (structureCount === 0) {
          throw new Error('结构下载或解析失败（PDB ID 不存在、服务器不可达，或网络中断）')
        }

        viewer.handleResize()
        button.remove()
        status.classList.add('hidden')
      } catch (err) {
        try {
          viewer?.dispose?.()
        } catch {
          // 清理失败的 viewer 实例本身失败，不应影响下面的错误提示与重试
        }
        mount?.remove()
        button.style.display = ''
        button.disabled = false
        button.textContent = '重试'
        // 用 err.message 而不是 String(err)：后者会带上 "Error: " 前缀，
        // 读者看到的是「结构加载失败：Error: 结构下载或解析失败……」
        setStatus(`结构加载失败：${err instanceof Error ? err.message : String(err)}`)
      }
    })
  })
</script>
