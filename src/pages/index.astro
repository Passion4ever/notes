---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import Search from '../components/Search.astro'
import { getLastModifiedInfo } from '../lib/gitdate'

const notes = await getCollection('notes')

// glob loader 的 entry 自带 filePath（相对项目根目录），但这不是 Astro 的公开
// API（只在内部 loader 类型上声明的字段）。如果它哪天缺失了，宁可在这里硬失败，
// 也不要悄悄拼一个大概率错误的路径（`notes/${id}.md` 对 .mdx 笔记必然拼错后缀）——
// 拼错的路径在 git 和 mtime 两层都会落空，getLastModifiedInfo 会静默把构建时刻
// 当成「最后更新」显示出去，没有任何提示，比直接崩溃更危险。
const sourcePath = (note: (typeof notes)[number]) => {
  const filePath = (note as { filePath?: string }).filePath
  if (!filePath) {
    throw new Error(
      `笔记 ${note.id} 缺少 filePath 字段。这通常意味着 Astro 的 content collection 内部结构变了，请检查 gitdate/index.astro 的取路径逻辑。`,
    )
  }
  return filePath
}

const enriched = notes.map((note) => {
  const info = getLastModifiedInfo(sourcePath(note))
  return {
    slug: note.id,
    title: note.data.title,
    tags: note.data.tags,
    updated: info.date,
    day: info.day,
  }
})

const recent = [...enriched].sort((a, b) => b.updated.getTime() - a.updated.getTime()).slice(0, 10)

// 按标签分组，标签内按标题排序
const byTag = new Map<string, typeof enriched>()
for (const note of enriched) {
  const tags = note.tags.length > 0 ? note.tags : ['未分类']
  for (const tag of tags) {
    const list = byTag.get(tag) ?? []
    list.push(note)
    byTag.set(tag, list)
  }
}
const tagGroups = [...byTag.entries()]
  .map(([tag, list]) => [tag, [...list].sort((a, b) => a.title.localeCompare(b.title, 'zh'))] as const)
  .sort((a, b) => b[1].length - a[1].length)
---

<Base title="笔记">
  <h1 class="text-2xl font-semibold">笔记</h1>

  <Search />

  <section class="mt-8" data-pagefind-ignore>
    <h2 class="text-sm font-semibold tracking-wide text-neutral-500">最近更新</h2>
    <ul class="mt-3 space-y-1">
      {
        recent.map((note) => (
          <li class="flex gap-3">
            <span class="tabular-nums text-sm text-neutral-400">{note.day}</span>
            <a href={`/n/${note.slug}`} class="text-blue-600 no-underline">
              {note.title}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-12" data-pagefind-ignore>
    <h2 class="text-sm font-semibold tracking-wide text-neutral-500">全部笔记</h2>
    {
      tagGroups.map(([tag, list]) => (
        <div class="mt-6">
          <h3 class="text-base font-medium">
            <a href={`/tags/${encodeURIComponent(tag)}`} class="no-underline">
              {tag}
            </a>
            <span class="ml-2 text-sm font-normal text-neutral-400">{list.length}</span>
          </h3>
          <ul class="mt-2 space-y-1">
            {list.map((note) => (
              <li>
                <a href={`/n/${note.slug}`} class="text-blue-600 no-underline">
                  {note.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</Base>
