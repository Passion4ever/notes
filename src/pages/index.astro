---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import Search from '../components/Search.astro'
import { getLastModifiedInfo } from '../lib/gitdate'
import { getNoteGraph } from '../lib/notegraph'

const notes = await getCollection('notes')
const aminoAcids = await getCollection('aminoAcids')
const { backlinks, unresolved } = await getNoteGraph()

// glob loader 的 entry 自带 filePath（相对项目根目录），但这不是 Astro 的公开
// API（只在内部 loader 类型上声明的字段）。如果它哪天缺失了，宁可在这里硬失败，
// 也不要悄悄拼一个大概率错误的路径（`notes/${id}.md` 对 .mdx 笔记必然拼错后缀）——
// 拼错的路径在 git 和 mtime 两层都会落空，getLastModifiedInfo 会静默把构建时刻
// 当成「最后更新」显示出去，没有任何提示，比直接崩溃更危险。
const sourcePath = (note: (typeof notes)[number]) => {
  const filePath = (note as { filePath?: string }).filePath
  if (!filePath) {
    throw new Error(
      `笔记 ${note.id} 缺少 filePath 字段。这通常意味着 Astro 的 content collection 内部结构变了，请检查 gitdate/index.astro 的取路径逻辑。`,
    )
  }
  return filePath
}

const enriched = notes.map((note) => {
  const href = `/n/${note.id}`
  return {
    href,
    title: note.data.title,
    tags: note.data.tags,
    updated: getLastModifiedInfo(sourcePath(note)).date,
    // 入链数：花园里衡量一个概念的分量，靠的是「多少地方提到它」
    degree: (backlinks.get(href) ?? []).length,
  }
})

const byTag = new Map<string, typeof enriched>()
for (const note of enriched) {
  for (const tag of note.tags.length > 0 ? note.tags : ['未分类']) {
    const list = byTag.get(tag) ?? []
    list.push(note)
    byTag.set(tag, list)
  }
}

// 标签按条目数降序 —— 让密的主题浮到上面，索引一眼能看出重心在哪
const tagRows = [...byTag.entries()]
  .map(
    ([tag, list]) =>
      [tag, [...list].sort((a, b) => b.degree - a.degree || a.title.localeCompare(b.title, 'zh'))] as const,
  )
  .sort((a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0], 'zh'))

// 待写：被别处引用、但还没写的概念。博客不会有这种东西 —— 它是花园在长的证据
const pending = [...unresolved.entries()]
  .map(([slug, refs]) => ({ slug, refs }))
  .sort((a, b) => b.refs.length - a.refs.length || a.slug.localeCompare(b.slug, 'zh'))

const recent = [...enriched].sort((a, b) => b.updated.getTime() - a.updated.getTime()).slice(0, 6)
---

<Base title="笔记" description="蛋白质与酶方向的知识笔记">
  <Search />

  <section class="mt-8" data-pagefind-ignore>
    <div class="sheet-row" style="border-top:none">
      <span class="u sheet-label">索引</span>
      <span class="u" style="padding-top:0.4rem"
        >{notes.length} 个概念 · {aminoAcids.length} 条参考数据</span
      >
    </div>

    {
      tagRows.map(([tag, list]) => (
        <div class="sheet-row">
          <a
            href={`/tags/${encodeURIComponent(tag)}`}
            class="u sheet-label no-underline"
            title={`${tag}（${list.length}）`}>
            {tag}
          </a>
          <div class="sheet-flow">
            {list.map((note) => (
              <a href={note.href} class="concept">
                {note.title}
                {note.degree > 0 && <span class="degree">{note.degree}</span>}
              </a>
            ))}
          </div>
        </div>
      ))
    }

    <div class="sheet-row">
      <span class="u sheet-label">参考</span>
      <div class="sheet-flow">
        <a href="/aa" class="concept">氨基酸速查<span class="degree">{aminoAcids.length}</span></a>
      </div>
    </div>
  </section>

  {/* 待写 —— 整个页面唯一的暖色。它是这套系统区别于博客的地方：
      清单不是我列的，是从实际写作里长出来的 */}
  <section class="mt-9" data-pagefind-ignore>
    <div class="sheet-row" style="border-color:color-mix(in srgb, var(--color-oxygen) 30%, transparent)">
      <span class="u sheet-label" style="color:var(--color-oxygen)">待写</span>
      <div class="sheet-flow">
        {
          pending.length > 0 ? (
            pending.map((p) => (
              <a
                href={`/n/${encodeURIComponent(p.slug)}`}
                class="concept"
                style="color:var(--color-oxygen)">
                {p.slug}
                <span class="degree" style="color:var(--color-oxygen)">
                  {p.refs.length}
                </span>
              </a>
            ))
          ) : (
            <p class="u" style="letter-spacing:normal">
              正文里写 <code>[[某个还没写的概念]]</code>，它会出现在这里。
            </p>
          )
        }
      </div>
    </div>
  </section>

  {/* 时间放在最后，且不显示日期 —— 它是「我刚才在弄什么」的书签，不是这个站的组织方式 */}
  <section class="mt-9" data-pagefind-ignore>
    <div class="sheet-row">
      <span class="u sheet-label">最近碰过</span>
      <div class="sheet-flow" style="gap:0.35rem 1.1rem">
        {
          recent.map((note) => (
            <a href={note.href} class="u no-underline" style="letter-spacing:0.02em">
              {note.title}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
