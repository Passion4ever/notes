---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { getNoteGraph } from '../../lib/notegraph'

export async function getStaticPaths() {
  const notes = await getCollection('notes')
  const { backlinks } = await getNoteGraph()
  const byTag = new Map<string, typeof notes>()

  for (const note of notes) {
    const tags = note.data.tags.length > 0 ? note.data.tags : ['未分类']
    for (const tag of tags) {
      const list = byTag.get(tag) ?? []
      list.push(note)
      byTag.set(tag, list)
    }
  }

  return [...byTag.entries()].map(([tag, list]) => ({
    params: { tag },
    props: {
      tag,
      entries: list.map((note) => ({
        href: `/n/${note.id}`,
        title: note.data.title,
        degree: (backlinks.get(`/n/${note.id}`) ?? []).length,
      })),
    },
  }))
}

const { tag, entries } = Astro.props
const sorted = [...entries].sort(
  (a, b) => b.degree - a.degree || a.title.localeCompare(b.title, 'zh'),
)
---

<Base title={`分类：${tag}`} crumb="分类">
  <h1 class="wiki-h1">分类：{tag}</h1>

  <div class="wiki-body">
    <p class="wiki-note lead">本分类共有 {sorted.length} 个条目，按被引用次数排列。</p>
    <ul class="wiki-catlist">
      {
        sorted.map((e) => (
          <li>
            <a href={e.href}>{e.title}</a>
            {e.degree > 0 && <span class="wiki-cnt">{e.degree}</span>}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="wiki-cats">
    <span>返回：</span>
    <a href="/">索引</a>
  </div>
</Base>

<style>
  .lead {
    margin: 0.6rem 0 0.9rem;
  }
</style>
