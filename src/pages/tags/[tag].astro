---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { getNoteGraph } from '../../lib/notegraph'

export async function getStaticPaths() {
  const notes = await getCollection('notes')
  const { backlinks } = await getNoteGraph()
  const byTag = new Map<string, typeof notes>()

  for (const note of notes) {
    const tags = note.data.tags.length > 0 ? note.data.tags : ['未分类']
    for (const tag of tags) {
      const list = byTag.get(tag) ?? []
      list.push(note)
      byTag.set(tag, list)
    }
  }

  return [...byTag.entries()].map(([tag, list]) => ({
    params: { tag },
    props: {
      tag,
      entries: list.map((note) => ({
        href: `/n/${note.id}`,
        title: note.data.title,
        degree: (backlinks.get(`/n/${note.id}`) ?? []).length,
      })),
    },
  }))
}

const { tag, entries } = Astro.props
const sorted = [...entries].sort(
  (a, b) => b.degree - a.degree || a.title.localeCompare(b.title, 'zh'),
)
---

<Base title={`标签：${tag}`}>
  <header class="mb-7 flex flex-wrap items-baseline gap-x-4">
    <h1 class="text-[1.6rem] leading-tight font-semibold">{tag}</h1>
    <span class="u">{sorted.length} 个概念</span>
  </header>

  <div data-pagefind-ignore>
    <div class="sheet-row">
      <span class="u sheet-label">标签</span>
      <div class="sheet-flow">
        {
          sorted.map((e) => (
            <a href={e.href} class="concept">
              {e.title}
              {e.degree > 0 && <span class="degree">{e.degree}</span>}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</Base>
