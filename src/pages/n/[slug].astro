---
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import Backlinks from '../../components/Backlinks.astro'
import Toc from '../../components/Toc.astro'
import Infobox from '../../components/Infobox.astro'
import { getNoteGraph } from '../../lib/notegraph'
import type { Ref } from '../../lib/linkgraph'

export async function getStaticPaths() {
  const notes = await getCollection('notes')
  const { backlinks, unresolved } = await getNoteGraph()

  const real = notes.map((note) => ({
    params: { slug: note.id },
    props: {
      note,
      // backlinks 以 href 为 key（见 linkgraph.ts），不是 slug——笔记与氨基酸
      // 的 slug 可能重名（如 cys.md 与氨基酸 Cys），href 按构造全站唯一。
      refs: backlinks.get(`/n/${note.id}`) ?? [],
      missingName: null as string | null,
    },
  }))

  // 未写的条目也生成页面：上面列出谁提到了它，本身即待写清单。
  // unresolved 的 key 已经是 placeholderSlug() 算出的路由 slug（在
  // linkgraph.ts 里写入时就转换过），可以直接当 params.slug 用，不需要
  // （也不应该）在这里再自己算一遍。
  const placeholders = [...unresolved.entries()].map(([slug, refs]) => ({
    params: { slug },
    props: { note: null, refs, missingName: slug },
  }))

  return [...real, ...placeholders]
}

const { note, refs, missingName } = Astro.props as {
  note: any
  refs: Ref[]
  missingName: string | null
}

const rendered = note ? await render(note) : null
const Content = rendered?.Content ?? null
// 维基的目录来自条目自身的章节结构。少于两个章节不显示 —— 一个目录只列
// 一项没有意义，维基也是到一定数量才出目录。
const headings = (rendered?.headings ?? []).filter((h: any) => h.depth === 2 || h.depth === 3)
const showToc = headings.length >= 2

const title = note ? note.data.title : missingName!
const tags: string[] = note?.data.tags ?? []
const infobox: { k: string; v: string }[] = note?.data.infobox ?? []
---

<Base title={title} crumb={note ? '条目' : '缺失条目'}>
  <h1 class="wiki-h1">{title}</h1>

  {
    !note && (
      <p class="hat">
        本条目尚未撰写。下面列出提到过它的页面 —— 从那里读起，通常就知道该写什么。
      </p>
    )
  }

  <div class="wiki-body">
    {/* 信息框与目录叠在同一侧栏，正文绕排。
        维基经典皮肤把目录插在导言之后、首个章节之前，但那需要把渲染好的
        正文切成两段；而把目录单独放在正文之前会和浮右的信息框各占一边、
        中间空出一大块。新版维基（Vector 2022）本就把目录移出正文当页面
        chrome，这里沿用那个思路：右侧一栏自上而下是信息框、目录。 */}
    {
      (infobox.length > 0 || showToc) && (
        <div class="wiki-aside">
          {infobox.length > 0 && <Infobox title={title} rows={infobox} />}
          {showToc && <Toc headings={headings} extra={refs.length > 0 ? '参见' : undefined} />}
        </div>
      )
    }
    {Content && <Content />}
    <Backlinks refs={refs} />
  </div>

  {
    tags.length > 0 && (
      <div class="wiki-cats">
        <span>分类：</span>
        {tags.map((tag) => (
          <a href={`/tags/${encodeURIComponent(tag)}`}>{tag}</a>
        ))}
      </div>
    )
  }
</Base>

<style>
  .hat {
    font-style: italic;
    color: var(--color-ink-soft);
    font-size: 0.875rem;
    margin: 0.55rem 0 1rem;
    padding-left: 1.6rem;
  }
</style>
